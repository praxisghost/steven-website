# Copy this file to .env and fill in your values
# (Never commit .env to git — it's already in .gitignore)

# PostgreSQL connection string
# Local example:  postgres://localhost:5432/steven_website
# Railway/Render: copy the connection string from your database dashboard
DATABASE_URL=

# Set to "production" when deploying
NODE_ENV=development

# Port to run the server on (hosting platforms set this automatically)
PORT=3000
