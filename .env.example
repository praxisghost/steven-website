# Copy this file to .env and fill in your values
# (Never commit .env to git — it's already in .gitignore)

# PostgreSQL connection string
# Local example:  postgres://localhost:5432/steven_website
# Railway/Render: copy the connection string from your database dashboard
DATABASE_URL=

# Set to "production" when deploying
NODE_ENV=development

# Port to run the server on (hosting platforms set this automatically)
PORT=3000

# ── Email (contact form notifications) ────────────────────────────────
# Sign up free at https://resend.com, create an API key, paste it here.
# Without this, messages are still saved to the database but no email is sent.
RESEND_API_KEY=

# Who the notification email appears to come from.
# Use onboarding@resend.dev for testing (no domain verification needed).
# For production, verify steven-legg.com with Resend and use e.g. contact@steven-legg.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Your private inbox — where contact form notifications will be delivered.
# This is intentionally a neutral example; enter your real address only in .env
# or your host's encrypted environment-variable manager.
CONTACT_TO_EMAIL=you@example.com

# ── Minecraft private-server access ────────────────────────────────────
# Cloudflare Turnstile keys: https://dash.cloudflare.com/?to=/:account/turnstile
# SITE_KEY is public and is sent to the browser. SECRET_KEY must remain private.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Set to the hostname configured in the Turnstile widget, e.g. steven-legg.com.
TURNSTILE_EXPECTED_HOSTNAME=

# The address returned only after a successful human check and whitelist write.
# Keep the current host:port in the deployment environment, not in this file.
MINECRAFT_SERVER_ADDRESS=

# Apex FTP credentials. Never put the password in source code, client JavaScript,
# Git, or a public hosting variable. Enter all of these only in Railway/Render's
# encrypted variable manager (and, if needed, your untracked local .env).
MINECRAFT_FTP_HOST=
MINECRAFT_FTP_PORT=21
MINECRAFT_FTP_USERNAME=
MINECRAFT_FTP_PASSWORD=
# Use true only if Apex has explicitly configured this connection for FTPS.
MINECRAFT_FTP_SECURE=false
# Confirm this exact path in Apex File Manager before deploying. For a standard
# Java server it is normally whitelist.json at the server root.
MINECRAFT_WHITELIST_PATH=whitelist.json

# TCP checks drive down/up maintenance emails. Use the same publicly reachable
# Minecraft host and port; the app sends no notice on its first baseline check.
MINECRAFT_STATUS_HOST=
MINECRAFT_STATUS_PORT=25565
# Minimum accepted interval is 60000 milliseconds.
MINECRAFT_STATUS_INTERVAL_MS=120000

# ── SANITY (blog CMS) ────────────────────────────────────────────────────────
# The Studio lives in the sibling folder studio-steven-legg.com. These two have
# safe defaults baked into sanity/client.ts, so you only need to set them here
# if you ever point the site at a different project or dataset.
SANITY_PROJECT_ID=mo87nuz0
SANITY_DATASET=production

# Only needed if you make the dataset private. Ordinary published reads on a
# public dataset work with no token at all. Create at sanity.io/manage →
# API → Tokens, with Viewer permission.
SANITY_API_READ_TOKEN=

# Shared secret for POST /api/blog/revalidate. Set this to any long random
# string, then add the same value as a custom header on the Sanity webhook so
# published posts clear the cache instantly. If left blank the endpoint stays
# disabled; published reads still refresh automatically within one minute.
SANITY_REVALIDATE_SECRET=
