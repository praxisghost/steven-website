# Copy to .env and fill in for local dev. NEVER commit real values.

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
# Comma-separated hostnames Django will serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database (PostgreSQL on Railway) ----
# Railway -> Postgres plugin -> Variables -> DATABASE_URL
# (in Railway you can reference it as ${{Postgres.DATABASE_URL}}).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Leave blank locally to use the sqlite fallback.
DATABASE_URL=
# Require SSL on the DB connection (Railway managed Postgres uses SSL).
DATABASE_SSL=True

# ---- CORS ----
# Comma-separated origins allowed to call this API (the Next.js frontend).
# In production add the deployed frontend origin, e.g. https://www.stevenlegg.xyz
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Production / deploy (Railway) ----
# Set DJANGO_DEBUG=False in the Railway service. RAILWAY_PUBLIC_DOMAIN is injected
# by Railway and auto-added to ALLOWED_HOSTS + CSRF_TRUSTED_ORIGINS.
# Extra CSRF origins (comma-separated https URLs) for the admin behind a custom domain:
CSRF_TRUSTED_ORIGINS=
# Force HTTPS redirects when DEBUG is off (default True). Set False only if needed.
DJANGO_SECURE_SSL_REDIRECT=True
# Reverse-proxy hop count for DRF throttling IP detection (Railway = 1).
NUM_PROXIES=1
