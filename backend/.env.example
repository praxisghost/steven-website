# Copy to .env and fill in for local dev. NEVER commit real values.

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
# Comma-separated hostnames Django will serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database (PostgreSQL on Railway) ----
# Railway -> Postgres plugin -> Variables -> DATABASE_URL
# (in Railway you can reference it as ${{Postgres.DATABASE_URL}}).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Leave blank locally to use the sqlite fallback.
DATABASE_URL=
# Require SSL on the DB connection (Railway managed Postgres uses SSL).
DATABASE_SSL=True

# ---- CORS ----
# Comma-separated origins allowed to call this API (the Next.js frontend).
# In production add the deployed frontend origin, e.g. https://www.stevenlegg.xyz
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Production / deploy (Railway) ----
# Set DJANGO_DEBUG=False in the Railway service. RAILWAY_PUBLIC_DOMAIN is injected
# by Railway and auto-added to ALLOWED_HOSTS + CSRF_TRUSTED_ORIGINS.
# Extra CSRF origins (comma-separated https URLs) for the admin behind a custom domain:
CSRF_TRUSTED_ORIGINS=
# Force HTTPS redirects when DEBUG is off (default True). Set False only if needed.
DJANGO_SECURE_SSL_REDIRECT=True
# Reverse-proxy hop count for DRF throttling IP detection (Railway = 1).
NUM_PROXIES=1

# ---- Payments (Stripe) — SKELETON, test mode only ----
# Master switch. Leave False until Stripe is wired + tested; while False the
# webhook + access endpoints are NOT mounted (see config/urls.py).
PAYMENTS_ENABLED=False
# Use TEST keys (sk_test_… / pk_test_…) from the Stripe dashboard until launch.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:8000/api/pay/webhook/stripe/`
# (whsec_…). Each endpoint/CLI session has its own secret.
STRIPE_WEBHOOK_SECRET=

# ---- Minecraft RCON (private network only; never expose publicly) ----
RCON_HOST=
RCON_PORT=25575
RCON_PASSWORD=

# ---- Checkout redirect targets (Next.js pages) ----
FRONTEND_BASE_URL=http://localhost:3000
# Optional explicit overrides; default to FRONTEND_BASE_URL + standard paths.
PAYMENTS_SUCCESS_URL=
PAYMENTS_CANCEL_URL=

# ---- Protected downloads ----
# Option A: stream from a PRIVATE dir (NOT under static/public). Absolute path.
PAYMENTS_DOWNLOAD_DIR=
# Option B: object storage that mints signed URLs (django-storages S3/GCS).
PAYMENTS_STORAGE_SIGNED=False
# Signed-URL / link lifetime in seconds.
PAYMENTS_DOWNLOAD_TTL=300
