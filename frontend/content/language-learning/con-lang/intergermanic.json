        ],
        [
          "durfte",
          "may (cautious permission)",
          "Ik durfte nicht gåe."
        ],
        [
          "skulde",
          "should, ought to",
          "Wi skulde hjelpe."
        ],
        [
          "wulde",
          "would (conditional)",
          "Ik wulde gjerne komme."
        ],
        [
          "tørre",
          "dare to",
          "Han tørre nicht seje det."
        ]
      ]
    },
    {
